# PostGIS (the container from the setup guide)
#   docker run --name ner-db -e POSTGRES_PASSWORD=ner -e POSTGRES_DB=ner \
#     -p 5432:5432 -d postgis/postgis
DATABASE_URL=postgresql+psycopg://postgres:ner@localhost:5432/ner

REDIS_URL=redis://localhost:6379/0

# Dashboard (Person 3) and driver PWA (Person 4)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seed PostGIS with the sample corridors when the tables are empty
AUTO_SEED=true
# Serve the in-memory sample when PostGIS is unreachable, instead of failing
ALLOW_MEMORY_FALLBACK=true

# WS /ws/vehicles: seconds between frames, and simulated-seconds per real second
WS_BROADCAST_SECONDS=2.0
WS_TIME_SCALE=60
