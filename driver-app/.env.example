# Base URL the PWA reads its data from.
# Leave as /mock-data to run fully standalone against repo-root/mock-data.
# Point at the FastAPI backend once it is up, e.g. http://localhost:8000
VITE_API_URL=/mock-data

# WebSocket the backend broadcasts simulated-mesh hop events on.
# Leave empty to fall back to the in-browser BroadcastChannel transport,
# which relays between tabs on this machine with no backend running.
VITE_WS_URL=

# Vehicle this device is assigned to (demo default).
VITE_VEHICLE_ID=AS-01-EG-4417
